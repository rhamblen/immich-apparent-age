# Copy to deploy/.env and fill in. .env is gitignored; this repo is public, so
# no real host address, GPU id or key belongs in any file that is committed.

# --- image -------------------------------------------------------------------
# Published by CI on every push to main. Pin to a tag or digest for a long run
# so an image update cannot change results mid-crawl.
IAA_IMAGE=ghcr.io/rhamblen/immich-apparent-age:latest
IAA_IMAGE_GPU=ghcr.io/rhamblen/immich-apparent-age:gpu

# --- data --------------------------------------------------------------------
# Host directory holding config.yaml, out/, crops/, reports/ and models/.
# Put it on the array or cache of the host that runs Immich, for example
# /mnt/user/appdata/immich-apparent-age
IAA_DATA_DIR=/mnt/user/appdata/immich-apparent-age

# --- Immich ------------------------------------------------------------------
# Create in Immich: avatar > Account Settings > API Keys. Read access is
# enough for phases 1-4. config.yaml refers to it as ${IMMICH_API_KEY}.
IMMICH_API_KEY=

# --- host --------------------------------------------------------------------
# Unraid appdata ownership is nobody:users.
PUID=99
PGID=100
TZ=UTC

# --- GPU (phase 2 only) ------------------------------------------------------
# A specific card from `nvidia-smi -L`, e.g. GPU-xxxxxxxx-xxxx-xxxx-xxxx-...
# Pin it: these hosts have more than one GPU and the others may be committed.
IAA_GPU_UUID=
